# [.env 설정 안내]
# 이 파일을 복사해서 .env로 만들고 실제 키를 채워 넣으세요. (.env는 git에 올라가지 않습니다)

DATABASE_URL=sqlite:///./umalgoritm.db

# YouTube Data API v3 키 (Sourcer가 사용) - Google Cloud Console에서 발급
YOUTUBE_API_KEY=

# LLM API 키 (Planner, Curator 2단계가 사용) - OpenAI 호환 엔드포인트면 다 가능
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
